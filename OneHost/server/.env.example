# OneHost backend
# Required in production
PORT=56
ONEHOST_PUBLIC_URL=https://sklep.onehost.site
JWT_SECRET=replace-with-strong-random-secret
ADMIN_EMAIL=Radewsk@gmail.com
ADMIN_PASSWORD_HASH=$2a$10$Pjrd6X2/pJ4IFDKCck9aWeJLTXsjzKDmbi6vmW81m2XGw5r8uVdCe
# Alternative (less secure): plain admin password, hashed automatically on startup
# ADMIN_PASSWORD=change-me
# Optional bootstrap when DB has no super_admin and ADMIN_* is missing
# ADMIN_BOOTSTRAP_EMAIL=admin@onehost.local
# ADMIN_BOOTSTRAP_PASSWORD=temporary-password

# Optional (required when enabling Stripe billing in production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Comma-separated allowlist for CORS (frontend origins)
ALLOWED_ORIGINS=https://sklep.onehost.site,https://shiftplanner.onehost.site,https://em.onehost.site,https://certtrack.onehost.site
