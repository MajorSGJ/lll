# CertTrack - Konfiguracja środowiskowa (Nginx + domena)
# Skopiuj ten plik jako .env i uzupełnij wartości

# JWT Secret (sesje użytkowników)
JWT_SECRET=twoj-tajny-klucz-jwt-zmien-to

# OneHost API do walidacji tokenu i dostępu
ONEHOST_API=http://127.0.0.1:56

# URL dashboard/billing w OneHost (używany przy redirectach)
ONEHOST_BILLING_URL=https://sklep.onehost.site/dashboard

# AUTH_ENABLED=0 tylko do lokalnego DEV bez OneHost
AUTH_ENABLED=1

# (Legacy / opcjonalne) Stripe, jeżeli utrzymujesz stary tryb kompatybilności
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Port serwera API (dla Nginx)
PORT=62

# Admin key współdzielony z OneHost (super-admin API, wymagany)
ONEHOST_ADMIN_KEY=

# URL OneHost Store (do linku w navbarze)
VITE_ONEHOST_STORE_URL=https://sklep.onehost.site

# Linki używane przez landing CertTrack
VITE_ONEHOST_URL=https://sklep.onehost.site
VITE_ONEHOST_LOGIN_URL=https://sklep.onehost.site/login
VITE_ONEHOST_REGISTER_URL=https://sklep.onehost.site/register

# Frontend dev port (Vite)
VITE_PORT=61
